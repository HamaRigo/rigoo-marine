# ===========================================
# RIGOO MARINE - ENVIRONMENT SECRETS
# ===========================================
# WARNING: This file contains sensitive credentials
# - NEVER commit this file to version control
# - Use different values per environment
# ===========================================

# ===========================================
# DOCKER HUB
# ===========================================
DOCKERHUB_USERNAME=rigoomarine

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rigoomarine
DB_HOST=localhost
DB_PORT=5432

# SSL/TLS - Set true for production
DB_SSL_ENABLED=false

# Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_MAX_LIFETIME=1800000
DB_QUERY_TIMEOUT=30000

# ===========================================
# REDIS CONFIGURATION (Cache)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ===========================================
# KAFKA CONFIGURATION
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===========================================
# EUREKA CONFIGURATION
# ===========================================
EUREKA_SERVER=http://localhost:8761/eureka/

# ===========================================
# JWT SECRETS (per module)
# ===========================================
# Client Module
JWT_SECRET=rigoo-marine-secret-key-change-in-production-12345
JWT_EXPIRATION=86400000

# Technician Module
TECHNICIAN_JWT_SECRET=rigoo-technician-jwt-secret-key-2026-change-in-prod
TECHNICIAN_JWT_EXPIRATION=86400000

# Admin Module
ADMIN_JWT_SECRET=rigoo-admin-jwt-secret-key-2026-change-in-prod
ADMIN_JWT_EXPIRATION=86400000

# ===========================================
# SERVER CONFIGURATION
# ===========================================
SERVER_PORT=8081
SERVER_BASE_URL=http://localhost:8081

# ===========================================
# FILE UPLOAD
# ===========================================
FILE_UPLOAD_DIR=./uploads

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=text
