# Docker Hub Configuration
DOCKERHUB_USERNAME=your-dockerhub-username

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=change-me-to-secure-password
POSTGRES_DB=rigoomarine

# JWT Secret (for auth service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@rigoomarine.com
SMTP_PASSWORD=your-smtp-password

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=rigoomarine-uploads
AWS_REGION=us-east-1

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
