# ===========================================
# RIGOO MARINE - ENVIRONMENT TEMPLATE
# ===========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# ===========================================

# ===========================================
# DOCKER HUB
# ===========================================
DOCKERHUB_USERNAME=your-dockerhub-username

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rigoomarine
DB_USERNAME=rigoomarine_app
DB_PASSWORD=your-secure-password-here

# SSL/TLS - Set true for production
DB_SSL_ENABLED=true

# Connection Pool (HikariCP) — keep MAX_SIZE ≤ 5 per service in local dev
# (11 DB-connected services × 5 = 55 connections, well under pg max_connections=100)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_MAX_LIFETIME=1800000
DB_QUERY_TIMEOUT=30000

# ===========================================
# REDIS CONFIGURATION (Cache)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ===========================================
# KAFKA CONFIGURATION
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===========================================
# EUREKA CONFIGURATION
# ===========================================
EUREKA_SERVER=http://localhost:8761/eureka/

# ===========================================
# JWT SECRETS (per module)
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-random-secret-minimum-32-characters
JWT_EXPIRATION=86400000

TECHNICIAN_JWT_SECRET=your-technician-secret-minimum-32-chars
TECHNICIAN_JWT_EXPIRATION=86400000

ADMIN_JWT_SECRET=your-admin-secret-minimum-32-characters
ADMIN_JWT_EXPIRATION=86400000

# ===========================================
# SERVER CONFIGURATION
# ===========================================
SERVER_PORT=8081
SERVER_BASE_URL=http://localhost:8081

# ===========================================
# FILE UPLOAD
# ===========================================
FILE_UPLOAD_DIR=./uploads

# ===========================================
# EMAIL (client-module + notification-module)
# ===========================================
# Set MAIL_ENABLED=false to log emails to stdout (dev mode)
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.your-provider.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@rigoomarine.qa
# Base URL used in email verification links — must match the frontend URL
PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# WHATSAPP (notification-module)
# ===========================================
# provider=log  → stdout (dev, no credentials needed)
# provider=twilio → Twilio Messaging API
# provider=meta  → Meta Cloud API (Graph v19)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio

# Twilio (when WHATSAPP_PROVIDER=twilio)
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=+14155238886

# Meta Cloud API (when WHATSAPP_PROVIDER=meta)
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_VERIFY_TOKEN=change-this-secret

# ===========================================
# STRIPE (invoice-module + shop-module)
# ===========================================
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===========================================
# INTERNAL API TOKEN (shop-module → invoice-module)
# ===========================================
INTERNAL_API_TOKEN=rigoo-internal-token-change-in-production

# ===========================================
# FRONTEND URL (for Stripe redirect + email links)
# ===========================================
FRONTEND_BASE_URL=http://localhost:3000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=text
