# =============================================================================
# RIGOO MARINE — PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env and fill in EVERY value marked CHANGE_ME before deploying.
# Generate secrets:  openssl rand -hex 64
# =============================================================================

# ── Docker Hub — required for docker compose to resolve pre-built images ─────
DOCKERHUB_USERNAME=rigoomarine
# Tag to deploy (set by CI to the git SHA; leave 'latest' for manual deploys)
DOCKER_TAG=latest

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=rigoo
DB_PASSWORD=CHANGE_ME_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password

# ── JWT — all services share one secret (min 64 hex chars) ───────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_minimum_64_hex_chars

# ── Internal service token (invoice ↔ shop) ───────────────────────────────────
# Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=CHANGE_ME_minimum_32_hex_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://rigoo-marine-frontend.vercel.app

# ── Frontend base URL (email links, Stripe success/cancel redirects) ──────────
FRONTEND_BASE_URL=https://rigoo-marine-frontend.vercel.app

# ── Stripe (leave empty to disable payments) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email / SMTP (set MAIL_ENABLED=true when ready) ───────────────────────────
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@rigoomarine.qa

# ── WhatsApp (set WHATSAPP_ENABLED=true when ready) ───────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
# Any random string — must match what you register in Meta webhook settings
WHATSAPP_META_VERIFY_TOKEN=CHANGE_ME
