# =============================================================================
# RIGOO MARINE — ENVIRONMENT TEMPLATE (safe to share)
# Copy to .env and fill in real values locally. Never commit .env.
# Generate secrets:  openssl rand -hex 64
# =============================================================================

# ── Docker Hub ────────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKER_TAG=latest

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── JWT — all services share one secret (min 64 hex chars) ───────────────────
JWT_SECRET=CHANGE_ME_minimum_64_hex_chars

# ── Internal service token (invoice ↔ shop) ───────────────────────────────────
INTERNAL_API_TOKEN=CHANGE_ME_minimum_32_hex_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3080

# ── External API URL (upload links, server base-url) ─────────────────────────
PUBLIC_API_URL=http://localhost:8080

# ── Frontend base URL (email links, Stripe success/cancel redirects) ──────────
FRONTEND_BASE_URL=http://localhost:3080

# ── Stripe (leave empty to disable payments) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email / SMTP (set MAIL_ENABLED=true when ready) ───────────────────────────
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# ── WhatsApp (set WHATSAPP_ENABLED=true when ready) ───────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_VERIFY_TOKEN=CHANGE_ME
