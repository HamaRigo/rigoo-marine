# Production environment — values here are overridden by Vercel env vars at build time.
# Set VITE_API_BASE_URL in the Vercel dashboard to the gateway URL (e.g. https://api.rigoomarine.com).
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000

VITE_APP_NAME=Rigoo Marine
VITE_APP_VERSION=1.0.0

VITE_ENABLE_ADMIN=true
VITE_ENABLE_TECHNICIAN=true

VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_ANALYTICS=false
