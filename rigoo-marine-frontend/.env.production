# Production environment — baked into the JS bundle at Docker build time.
# httpClient.js falls back to http://localhost:8080 when this is empty, so it MUST be set.
VITE_API_BASE_URL=https://api.rigoomarine.com
VITE_API_TIMEOUT=30000

VITE_APP_NAME=Rigoo Marine
VITE_APP_VERSION=1.0.0

VITE_ENABLE_ADMIN=true
VITE_ENABLE_TECHNICIAN=true

VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_ANALYTICS=false
